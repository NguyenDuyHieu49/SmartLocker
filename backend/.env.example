DATABASE_URL=sqlite+aiosqlite:///./smartlocker.db
ENVIRONMENT=development
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-another-random-secret
DEMO_MODE=true
ALLOW_DOOR_SIMULATION=false
BOOTSTRAP_ADMIN_PHONE=0900000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

API_URL=https://api.smartbox.id.vn
DASHBOARD_URL=https://smartbox.id.vn
CORS_ORIGINS=http://localhost:3000,https://smartbox.id.vn,https://app.smartbox.id.vn

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MQTT_TLS_INSECURE=false
MQTT_CLIENT_ID=smartlocker-backend
MQTT_KEEPALIVE=60
DEVICE_OFFLINE_AFTER_SECONDS=20
COMMAND_TIMEOUT_SECONDS=15

PAYMENT_PROVIDER=payos
PAYOS_ENABLED=true
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CONFIRM_WEBHOOK_ON_STARTUP=false

MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_TIMEOUT_SECONDS=30

BASE_FEE_VND=5000
GRACE_MINUTES=60
BILLING_UNIT_MINUTES=60
UNIT_FEE_VND=2000

